# FiscalAI Environment Variables
# Copy this to .env and adjust values for your environment

# ═══════════════════════════════════════════════════════════════════════════
# DOCKER COMPOSE SETUP (Development)
# ═══════════════════════════════════════════════════════════════════════════
# When using docker-compose, use these internal service names as hostnames:
# - Database: postgres:5432
# - Redis: redis:6379
# - MinIO: minio:9000
# - Backend: http://backend:8000

# ═══════════════════════════════════════════════════════════════════════════
# API Configuration
# ═══════════════════════════════════════════════════════════════════════════
DEBUG=true
API_TITLE=FiscalAI
API_VERSION=0.1.0

# ═══════════════════════════════════════════════════════════════════════════
# Database Configuration (PostgreSQL)
# ═══════════════════════════════════════════════════════════════════════════
# Local development: localhost:5432
# Docker Compose: postgres:5432
DATABASE_URL=postgresql://fiscalai_user:fiscalai_password_dev@postgres:5432/fiscalai_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ═══════════════════════════════════════════════════════════════════════════
# Cache Configuration (Redis)
# ═══════════════════════════════════════════════════════════════════════════
# Local development: localhost:6379
# Docker Compose: redis:6379
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# ═══════════════════════════════════════════════════════════════════════════
# Object Storage Configuration (MinIO / S3)
# ═══════════════════════════════════════════════════════════════════════════
# Local development: localhost:9000
# Docker Compose: minio:9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_password_dev
MINIO_BUCKET_NAME=fiscalai-documents
MINIO_USE_SSL=false

# MinIO Console: http://localhost:9001
# Default credentials: minioadmin / minioadmin_password_dev

# ═══════════════════════════════════════════════════════════════════════════
# Celery Configuration (Task Queue)
# ═══════════════════════════════════════════════════════════════════════════
# Local development: localhost:6379
# Docker Compose: redis:6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000

# Flower monitoring: http://localhost:5555

# ═══════════════════════════════════════════════════════════════════════════
# CORS Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Development: Allow all origins
# Production: Specify allowed origins
CORS_ORIGINS=["*"]

# ═══════════════════════════════════════════════════════════════════════════
# Security Configuration
# ═══════════════════════════════════════════════════════════════════════════
# ⚠️ CHANGE THESE IN PRODUCTION!
SECRET_KEY=fiscal-ai-development-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ═══════════════════════════════════════════════════════════════════════════
# Logging Configuration
# ═══════════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════════════
# Frontend Configuration
# ═══════════════════════════════════════════════════════════════════════════
VITE_API_BASE_URL=http://localhost:8000

# ═══════════════════════════════════════════════════════════════════════════
# Admin Credentials (Development Only)
# ═══════════════════════════════════════════════════════════════════════════
# ⚠️ Change these immediately in production environments
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_in_production