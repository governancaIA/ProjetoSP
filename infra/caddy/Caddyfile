# ============================================================
#  FiscalAI — Caddyfile
#
#  MODO ATUAL: HTTP por IP (sem domínio)
#  Acesse: http://89.116.214.246
#
#  QUANDO TIVER DOMÍNIO: comente o bloco ":80" abaixo e
#  descomente o bloco "SEU_DOMINIO.COM" — o Caddy obtém
#  o certificado SSL automaticamente via Let's Encrypt.
# ============================================================

# ---- Modo IP-only (HTTP) ----
:80 {
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:80
    }
}

# ---- Modo com domínio (HTTPS + SSL automático) ----
# Para ativar: comente o bloco :80 acima e descomente abaixo.
# Pré-requisito: DNS do domínio já apontando para 89.116.214.246
