# ============================================================
#  FiscalAI — Variáveis de Ambiente — Produção (VPS Ubuntu)
#
#  1. Copie este arquivo: cp .env.prod.example .env.prod
#  2. Preencha TODOS os valores marcados com <ALTERAR>
#  3. NUNCA commite .env.prod no git
# ============================================================

# ----- App -----
ENV=production
DEBUG=False
LOG_LEVEL=INFO
SECRET_KEY=<ALTERAR — gere com: python -c "import secrets; print(secrets.token_hex(32))">

# ----- Domínio -----
# Mesmo valor usado no Caddyfile
DOMAIN=<ALTERAR — ex: fiscalai.com>
ALLOWED_HOSTS=<ALTERAR — ex: fiscalai.com,www.fiscalai.com>
CORS_ORIGINS=https://<ALTERAR — ex: fiscalai.com>,https://www.<ALTERAR>

# ----- PostgreSQL -----
POSTGRES_USER=fiscalai_user
POSTGRES_PASSWORD=<ALTERAR — senha forte>
POSTGRES_DB=fiscalai_db
DATABASE_URL=postgresql://fiscalai_user:<ALTERAR_SENHA_POSTGRES>@postgres:5432/fiscalai_db

# ----- Redis -----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ----- MinIO -----
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=<ALTERAR — ex: fiscalai_minio_admin>
MINIO_ROOT_PASSWORD=<ALTERAR — senha forte, mínimo 8 chars>
MINIO_BUCKET=fiscalai-documents
# URL de redirect do console MinIO
# Modo IP-only (sem domínio): http://89.116.214.246:9001
# Modo com domínio: https://storage.<ALTERAR_DOMINIO>
MINIO_BROWSER_REDIRECT_URL=http://89.116.214.246:9001
