# Backend Environment Variables Template
# Copy to .env and configure for your environment

# Environment
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql://fiscalai_user:fiscalai_password@localhost:5432/fiscalai_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# MinIO / S3 (local development)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password
MINIO_USE_SSL=false
MINIO_BUCKET=fiscalai-documents

# Security
SECRET_KEY=fiscal-ai-development-key-change-in-production-use-32-random-chars
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# FastAPI
API_PREFIX=/api/v1

# Anthropic API (optional — enables AI narrative in PDF reports)
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=
