# Backend Environment Variables Template
# Copy to .env and configure for your environment

# Database
DATABASE_URL=postgresql://fiscalai_user:fiscalai_password_dev@localhost:5432/fiscalai_db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_password_dev
MINIO_USE_SSL=false
MINIO_BUCKET=fiscalai-documents

# Security
SECRET_KEY=fiscal-ai-development-key-change-in-production
DEBUG=true

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
