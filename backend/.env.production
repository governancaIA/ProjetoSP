# ===== FiscalAI Backend — Production Environment =====
# Última atualização: 2026-05-24

# ===== ENVIRONMENT =====
ENV=production
DEBUG=False
LOG_LEVEL=INFO

# ===== API Configuration =====
API_V1_STR=/api/v1
PROJECT_NAME=FiscalAI
PROJECT_VERSION=0.1.0
ALLOWED_HOSTS=seu-dominio.com,www.seu-dominio.com,backend,localhost

# ===== DATABASE (PostgreSQL) =====
DATABASE_URL=postgresql://fiscalai_user:seu_postgres_password_aqui@postgres:5432/fiscalai_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fiscalai_db
POSTGRES_USER=fiscalai_user
POSTGRES_PASSWORD=seu_postgres_password_aqui

# ===== REDIS (Cache & Message Broker) =====
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ===== CELERY Configuration =====
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=America/Sao_Paulo

# ===== MinIO (Object Storage) =====
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=seu_minio_password_aqui
MINIO_BUCKET=fiscalai-documents
MINIO_USE_SSL=False
MINIO_REGION=us-east-1

# ===== CORS Configuration =====
CORS_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com,http://localhost:5173

# ===== Security & Authentication =====
SECRET_KEY=gere-uma-chave-segura-com-32-caracteres-minimo-aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Database Connection Pooling =====
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600

# ===== Observability =====
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===== Email Configuration (para notificações) =====
SMTP_SERVER=smtp.seu-email.com
SMTP_PORT=587
SMTP_USER=seu-email@seu-dominio.com
SMTP_PASSWORD=sua_senha_smtp_aqui
SMTP_FROM=noreply@seu-dominio.com
SMTP_FROM_NAME=FiscalAI

# ===== Features =====
ENABLE_SWAGGER=True
ENABLE_REDOC=True
ENABLE_OPENAPI=True

# ===== Rate Limiting =====
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=100

# ===== File Upload Configuration =====
MAX_UPLOAD_SIZE_MB=100
ALLOWED_FILE_TYPES=.txt,.xml

# ===== Timezone =====
TZ=America/Sao_Paulo
